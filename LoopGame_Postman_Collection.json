							"raw": "{{baseUrl}}/api/sidetask/:playerId/assign",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"sidetask",
								":playerId",
								"assign"
							],
							"variable": [
								{
									"key": "playerId",
									"value": "{{playerId}}",
									"description": "ID of the player"
								}
							]
						},
						"description": "Manually assigns a new side task for the player (Requires Admin role)."
					},
					"response": []
				}
			]
		}
