		{
			"name": "SideTask",
			"description": "Side-task endpoints for players: view active task, submit solution, abandon task, unlock hints, and admin assignment.",
			"auth": {
				"type": "bearer",
				"bearer": [
					{
						"key": "token",
						"value": "{{token}}",
						"type": "string"
					}
				]
			},
			"item": [
				{
					"name": "Get Active Side Task",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/sidetask/:playerId/active",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"sidetask",
								":playerId",
								"active"
							],
							"variable": [
								{
									"key": "playerId",
									"value": "{{playerId}}",
									"description": "ID of the player"
								}
							]
						},
						"description": "Returns the player's currently active side task."
					},
					"response": []
				},
				{
					"name": "Submit Side Task Solution",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"sideTaskId\": 1,\n  \"submittedCode\": \"using System;\\npublic class Solution {\\n    public int Solve() {\\n        return 42;\\n    }\\n}\",\n  \"timeSpentSec\": 120,\n  \"sahmHintsUsed\": 0\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/sidetask/:playerId/submit",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"sidetask",
								":playerId",
								"submit"
							],
							"variable": [
								{
									"key": "playerId",
									"value": "{{playerId}}",
									"description": "ID of the player"
								}
							]
						},
						"description": "Submits player code solution for grading and reward calculation."
					},
					"response": []
				},
				{
					"name": "Abandon Side Task",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/sidetask/:playerId/:sideTaskId/abandon",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"sidetask",
								":playerId",
								":sideTaskId",
								"abandon"
							],
							"variable": [
								{
									"key": "playerId",
									"value": "{{playerId}}",
									"description": "ID of the player"
								},
								{
									"key": "sideTaskId",
									"value": "1",
									"description": "ID of the side task to abandon"
								}
							]
						},
						"description": "Abandons the active task, applies the penalty (-100 EGP), and moves to next queued task if available."
					},
					"response": []
				},
				{
					"name": "Get Hints for Side Task",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/sidetask/:playerId/:sideTaskId/hints",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"sidetask",
								":playerId",
								":sideTaskId",
								"hints"
							],
							"variable": [
								{
									"key": "playerId",
									"value": "{{playerId}}",
									"description": "ID of the player"
								},
								{
									"key": "sideTaskId",
									"value": "1",
									"description": "ID of the side task"
								}
							]
						},
						"description": "Returns all hints for the side task. Locked hints have HintText = null."
					},
					"response": []
				},
				{
					"name": "Unlock Hint",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"sideTaskId\": 1,\n  \"hintLevel\": 1\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/sidetask/:playerId/hints/unlock",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"sidetask",
								":playerId",
								"hints",
								"unlock"
							],
							"variable": [
								{
									"key": "playerId",
									"value": "{{playerId}}",
									"description": "ID of the player"
								}
							]
						},
						"description": "Unlocks a hint level (1 = ConceptualNudge, 2 = StructuralGuidance, 3 = CodeSnippet), deducting EGP cost."
					},
					"response": []
				},
				{
					"name": "Assign Task (Admin)",
					"request": {
						"auth": {
							"type": "bearer",
