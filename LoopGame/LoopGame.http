  "taskOrder": 3,
  "title": "Fix the Boundary",
  "description": "Correct the condition so 200 EGP and every larger total receives the discount.",
  "starterCode": "#include <stdio.h>\n\nint main() {\n    int total;\n    scanf(\"%d\", &total);\n    if (total > 200) {\n        printf(\"10%% discount applied\");\n    } else {\n        printf(\"No discount\");\n    }\n    return 0;\n}",
  "conceptTag": "Conditionals",
  "difficulty": "Challenge",
  "maxAttempts": 0,
  "egpReward": 35,
