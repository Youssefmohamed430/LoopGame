      "description": "Boundary must be inclusive."
    },
    {
      "testCaseId": 0,
      "taskId": null,
      "sideTaskId": null,
      "testInput": "201",
      "expectedOutput": "10% discount applied",
      "isHidden": true,
      "description": "Values above the boundary also qualify."
    }
  ]
}


