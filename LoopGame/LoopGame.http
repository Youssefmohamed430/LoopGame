### LoopGame — Chapter One: Grand Opening — Admin Content Setup
### Based on: SHIFT — Chapter One: "Grand Opening"
### Scenario: Variables -> Conditionals -> Loops
### Runtime player actions intentionally excluded:
### StartShift, SubmitChoice, SubmitCode, and other gameplay/runtime endpoints are NOT included.

@baseUrl = http://localhost:44398

# ============================================================
# 0) PLAYERS
# ============================================================
# The current API exposes registration through /api/auth/register.
# Register two players that can later be used for gameplay testing.

### Player 1 — Mohamed
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "userName": "mohamed",
  "name": "Mohamed",
  "email": "yossefmohmed430@gmail.com",
  "password": "Mohamed#1234",
  "confirmPassword": "Mohamed#1234"
}

> {%
client.global.set("player1Id", response.body.player_id);
client.global.set("player1AccessToken", response.body.access_token);
%}

###

### Player 2 — Test Player
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "userName": "player11",
  "name": "Player1",
  "email": "player1@example.com",
  "password": "Player1234",
  "confirmPassword": "Player1234"
}

> {%
client.global.set("player2Id", response.body.player_id);
client.global.set("player2AccessToken", response.body.access_token);
%}


# ============================================================
# CHAPTER ONE
# ============================================================
# Chapter One contains:
#   Shift 1 -> Variables
#   Shift 2 -> Conditionals
#   Shift 3 -> Loops
#
# The Capstone "Grand Opening" is represented as the final
# milestone inside Shift 3 because the current scenario does
# not define a separate Capstone entity/endpoint.


# ============================================================
# 1) SHIFT ONE — VARIABLES
# ============================================================

### Create Shift 1
POST {{baseUrl}}/api/admin/shifts
Content-Type: application/json

{
  "shiftNumber": 1,
  "chapterNumber": 1,
  "title": "Variables",
  "description": "Mohamed's first task at Loop: build Tante Layla's menu and discover why variables are useful.",
  "conceptTag": "Variables",
  "isCapstone": false,
  "NumberOfTasks" : 3,
  "unlockCondition": null
}

> {%
client.global.set("shift1Id", response.body.shift_id);
%}

###

### Shift 1 — Beat 1 — Youssef sends the first task
POST {{baseUrl}}/api/admin/beats
Content-Type: application/json

{
  "shiftId": {{shift1Id}},
  "beatKey": "ch1_s1_first_task",
  "beatType": "Narrative",
  "sequenceOrder": 1,
  "app": "MailLoop",
  "senderName": "Youssef",
  "contentJson": {
    "text": "Subject: Tante Layla — First Build\nStart with the menu.\nCoffee, tea, croissant.\nNames and prices.\nMake it appear when the register opens.",
    "avatar": "youssef",
    "sound_effect": null,
    "choices": null
  },
  "desktopEvent": null,
  "delaySeconds": 0,
  "hasChoices": true
}

> {%
client.global.set("s1Beat1Id", response.body.beat_id);
%}

