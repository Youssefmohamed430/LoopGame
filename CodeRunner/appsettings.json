{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CodeRunner": {
    "DockerImage": "shift-c-runner:latest",
    "TimeoutSeconds": 5,
    "MemoryLimitMb": 128,
    "CpuLimit": 0.5,
    "MaxProcesses": 64,
    "MaxOutputBytes": 1048576
  }
}
